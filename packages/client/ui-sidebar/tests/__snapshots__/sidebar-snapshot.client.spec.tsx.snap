// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders the collapsed rail after the crossfade settles, in place 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="logoRow"
    >
      <button
        aria-label="Open sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          data-content="35f95b0c"
          fill="none"
          height="18"
          viewBox="0 0 16 16"
          width="18"
          xmlns="http://www.w3.org/2000/svg"
        />
      </button>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders the expanded column (wordmark, capsule, empty holes) 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
    >
      <span
        aria-hidden="true"
        class="brandIdentity"
      >
        <span
          class="brandName"
        >
          <div
            data-slot="sidebar.brand.name"
            style="display: contents;"
          >
            <span
              class="fallbackBrandName"
            >
              DeepSeek Harness Claude
            </span>
          </div>
        </span>
      </span>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <svg
        data-content="31127fcc"
        fill="none"
        height="16"
        viewBox="0 0 16 16"
        width="16"
        xmlns="http://www.w3.org/2000/svg"
      />
      <span
        class="newSessionLabel wide"
      >
        New
      </span>
    </button>
    <nav
      aria-label="Navigation"
      class="navRows"
    >
      <button
        class="navRow"
        type="button"
      >
        <span
          class="navIcon"
        >
          <svg
            aria-hidden="true"
            data-content="33eeb1a9"
            height="16"
            viewBox="0 0 16 16"
            width="16"
          />
        </span>
        <span
          class="navLabel"
        >
          Projects
        </span>
      </button>
      <button
        class="navRow"
        type="button"
      >
        <span
          class="navIcon"
        >
          <svg
            aria-hidden="true"
            data-content="a1407788"
            height="16"
            viewBox="0 0 16 16"
            width="16"
          />
        </span>
        <span
          class="navLabel"
        >
          Artifacts
        </span>
      </button>
      <button
        class="navRow"
        disabled=""
        title="Coming soon"
        type="button"
      >
        <span
          class="navIcon"
        >
          <svg
            aria-hidden="true"
            data-content="0b9abeaf"
            height="16"
            viewBox="0 0 16 16"
            width="16"
          />
        </span>
        <span
          class="navLabel"
        >
          Personalize
        </span>
      </button>
    </nav>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        aria-hidden="true"
        class="hiddenSettings"
      >
        <div
          class="settingsArea"
        >
          <div
            data-slot="sidebar.settings"
            style="display: contents;"
          />
        </div>
      </div>
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        >
          <button
            class="navRow"
            type="button"
          >
            <span
              class="navIcon"
            >
              <svg
                aria-hidden="true"
                data-content="f05efdfd"
                height="16"
                viewBox="0 0 16 16"
                width="16"
              />
            </span>
            <span
              class="navLabel"
            >
              Design
            </span>
          </button>
        </div>
      </div>
      <div
        class="footRow"
      >
        <span
          class="root menuStretch"
        >
          <button
            aria-expanded="false"
            aria-haspopup="menu"
            class="profileRow"
            type="button"
          >
            <span
              aria-hidden="true"
              class="avatar"
              style="background: var(--dsc-coral-500, #cc785c);"
            />
            <span
              class="profileName"
            />
            <span
              aria-hidden="true"
              class="profileChevron"
            >
              ⌄
            </span>
          </button>
        </span>
        <div
          class="footCluster"
        >
          <button
            aria-label="Settings"
            class="iconButton"
            type="button"
          >
            <svg
              data-content="6d8cd466"
              fill="none"
              height="16"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
          </button>
          <button
            aria-label="Collapse sidebar"
            class="iconButton"
            type="button"
          >
            <svg
              data-content="35f95b0c"
              fill="none"
              height="16"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;

