// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders the collapsed rail after the crossfade settles, in place 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="logoRow"
    >
      <button
        aria-label="Abrir barra lateral"
        class="iconButton toggle"
        type="button"
      >
        <svg
          data-content="35f95b0c"
          fill="none"
          height="18"
          viewBox="0 0 16 16"
          width="18"
          xmlns="http://www.w3.org/2000/svg"
        />
      </button>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders the expanded column (wordmark, capsule, empty holes) 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
    >
      <span
        aria-hidden="true"
        class="brandIdentity"
      >
        <span
          class="brandName"
        >
          <div
            data-slot="sidebar.brand.name"
            style="display: contents;"
          >
            <span
              class="fallbackBrandName"
            >
              Claude
            </span>
          </div>
        </span>
      </span>
    </div>
    <button
      aria-label="Nova sessão"
      class="newSession"
      type="button"
    >
      <svg
        data-content="31127fcc"
        fill="none"
        height="16"
        viewBox="0 0 16 16"
        width="16"
        xmlns="http://www.w3.org/2000/svg"
      />
      <span
        class="newSessionLabel wide"
      >
        Novo
      </span>
    </button>
    <nav
      aria-label="Navegação"
      class="navRows"
    >
      <button
        class="navRow"
        type="button"
      >
        <span
          class="navIcon"
        >
          <svg
            aria-hidden="true"
            data-content="33eeb1a9"
            height="16"
            viewBox="0 0 16 16"
            width="16"
          />
        </span>
        <span
          class="navLabel"
        >
          Projetos
        </span>
      </button>
      <button
        class="navRow"
        type="button"
      >
        <span
          class="navIcon"
        >
          <svg
            aria-hidden="true"
            data-content="a1407788"
            height="16"
            viewBox="0 0 16 16"
            width="16"
          />
        </span>
        <span
          class="navLabel"
        >
          Artefatos
        </span>
      </button>
      <button
        class="navRow"
        disabled=""
        title="Em breve"
        type="button"
      >
        <span
          class="navIcon"
        >
          <svg
            aria-hidden="true"
            data-content="385b197c"
            height="16"
            viewBox="0 0 16 16"
            width="16"
          />
        </span>
        <span
          class="navLabel"
        >
          Código
        </span>
      </button>
      <button
        class="navRow"
        disabled=""
        title="Em breve"
        type="button"
      >
        <span
          class="navIcon"
        >
          <svg
            aria-hidden="true"
            data-content="0b9abeaf"
            height="16"
            viewBox="0 0 16 16"
            width="16"
          />
        </span>
        <span
          class="navLabel"
        >
          Personalizar
        </span>
      </button>
    </nav>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        aria-hidden="true"
        class="hiddenSettings"
      >
        <div
          class="settingsArea"
        >
          <div
            data-slot="sidebar.settings"
            style="display: contents;"
          />
        </div>
      </div>
      <div
        class="footRow"
      >
        <div
          class="footerActions"
        >
          <div
            data-slot="sidebar.footer.action"
            style="display: contents;"
          />
        </div>
        <span
          class="root"
        >
          <button
            aria-expanded="false"
            aria-haspopup="menu"
            class="profileRow"
            type="button"
          >
            <span
              aria-hidden="true"
              class="avatar"
            >
              A
            </span>
            <span
              class="profileName"
            >
              Arthur
            </span>
            <span
              aria-hidden="true"
              class="profileChevron"
            >
              ⌄
            </span>
          </button>
        </span>
        <div
          class="footCluster"
        >
          <button
            aria-label="Buscar conversas"
            class="iconButton"
            type="button"
          >
            <svg
              data-content="4ca56c6d"
              fill="none"
              height="16"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
          </button>
          <button
            aria-label="Recolher barra lateral"
            class="iconButton"
            type="button"
          >
            <svg
              data-content="35f95b0c"
              fill="none"
              height="16"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
`;

