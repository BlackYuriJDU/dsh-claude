{
  "name": "@deepseek-ai/dsh-dshc",
  "description": "The DSHC bundle: Chat, Cowork, and Code presets with the DSHC persona, saved memories, per-workspace projects, the DSHC brand and Claude-app palette, and keyless SearXNG search over dsh-web-app",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/dshc"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./presets/*.patch.yml": "./presets/*.patch.yml"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "presets/chat.patch.yml",
    "presets/cowork.patch.yml",
    "presets/code.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/chat.patch.yml",
        "./presets/cowork.patch.yml",
        "./presets/code.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-brand-dshc": "workspace:*",
    "@deepseek-ai/dsh-client-ui-memory": "workspace:*",
    "@deepseek-ai/dsh-client-ui-projects": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-searxng": "workspace:*",
    "@deepseek-ai/dsh-web-search-searxng": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
