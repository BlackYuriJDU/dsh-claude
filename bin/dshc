#!/usr/bin/env bash
# dshc — DSH Claude launcher (DeepSeek Harness fork)
#
# Isolamento total da instância do senhor (dsh na 3080):
#   DSH_HOME      → ~/.dshc   (settings, credenciais, skills, perfis, sessões)
#   DSHC_WORKSPACE→ ~/dsh-claude-work (cwd do app: escopo dos projetos/sessões)
# Porta padrão 3090. Tudo sobrescrevível por env: DSHC_DSH_HOME, DSHC_WORKSPACE,
# DSHC_PORT. Rodar `dshc web` de qualquer lugar nunca toca a instância 3080.
set -euo pipefail
export DSH_HOME="${DSHC_DSH_HOME:-$HOME/.dshc}"
DSHC_WORKSPACE="${DSHC_WORKSPACE:-$HOME/dsh-claude-work}"
DSHC_PORT="${DSHC_PORT:-3090}"
DSHC_HOME="${DSHC_HOME:-/home/arthur/jarvis/dsh-claude}"
mkdir -p "$DSHC_WORKSPACE" "$DSH_HOME/profiles"
cd "$DSHC_WORKSPACE"
CLI_DIST="$DSHC_HOME/apps/cli/dist/bin.js"
BIN="$CLI_DIST"
[ -f "$BIN" ] || BIN=/home/arthur/.local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js
if [ "${1:-}" = "web" ] && ! printf '%s\n' "$@" | grep -q -- '--port'; then
  exec node "$BIN" web --port "$DSHC_PORT" "${@:2}"
fi
exec node "$BIN" "$@"
